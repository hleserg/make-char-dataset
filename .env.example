# Copy to .env and fill in. NEVER commit .env.
# All app settings use the APP_ prefix (see src/make_char_dataset/config.py).

APP_ENVIRONMENT=development
APP_DEBUG=false

# --- Sentry (optional; empty DSN disables Sentry) ---
APP_SENTRY_DSN=
APP_SENTRY_ENVIRONMENT=development
APP_SENTRY_RELEASE=
APP_SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Pipeline: workspace + dataset identity ---
APP_WORKSPACE=workspace
APP_TRIGGER_TOKEN=character
APP_DATASET_REPEATS=10

# --- Pipeline: generation backend ---
# backend: comfyui | diffusers | stub
APP_BACKEND=comfyui
APP_COMFY_URL=http://127.0.0.1:8188
# base_model: sdxl (default today) | flux  (HLE-670 final choice deferred)
APP_BASE_MODEL=sdxl
APP_VARIANTS_PER_CHARACTER=36
# controlnet: openpose | depth | none. License-safe only — PuLID / IP-Adapter /
# InstantID (InsightFace) are forbidden for the commercial dataset (HLE-668).
APP_CONTROLNET=openpose
# ControlNet checkpoint filename for the chosen mode (you provide this, HLE-759).
# Empty disables the ControlNet subgraph until a model is supplied.
APP_CONTROLNET_MODEL=
APP_IMG2IMG_DENOISE=0.75

# --- Pipeline: external style LoRA (Style Locker — style lives outside the character) ---
# Path to the pre-trained style LoRA .safetensors (you provide this).
APP_STYLE_LORA_PATH=
APP_STYLE_LORA_WEIGHT=0.85
# Style prompt / [STYLE] trigger — applied at generation, kept OUT of captions.
APP_STYLE_PROMPT=

# --- Pipeline: dataset cleaning + layout ---
APP_DEDUP_HAMMING_DISTANCE=6
APP_MIN_SIDE_PX=512
APP_TARGET_SIDE=1024
APP_INCLUDE_REJECTED=false

# --- Pipeline: captioning (VLM prose by default) ---
# captioner: vlm (Gemini prose via the proxy; default) | wd14 (legacy tagger) | stub
APP_CAPTIONER=vlm
APP_VLM_MODEL=gemini-2.5-flash
APP_VLM_CONCURRENCY=8
# Downscale each image to this longest side before captioning (full-res bodies time
# out the proxy upload; 768 is fast and ample for a VLM).
APP_VLM_MAX_IMAGE_SIDE=768
APP_VLM_PROXY_URL=https://hleserg-proxy-gemini-api.hf.space/gradio_api/call/caption
# HF token to CALL the proxy (read access is enough). Falls back to the
# huggingface-cli login cache (~/.cache/huggingface/token) when HF_TOKEN is unset.
# (HF_TOKEN is documented in the training section below.)
# WD14 fallback only (APP_CAPTIONER=wd14): the ONNX model + label CSV you provide.
APP_WD14_MODEL_PATH=
APP_WD14_LABELS_PATH=
APP_WD14_THRESHOLD=0.35

# --- Pipeline: char-LoRA training (heavy; opt-in; via ostris ai-toolkit) ---
# The char-LoRA trains on Flux.1-dev so it stacks with the cmcstyle style LoRA
# (Flux + cmcstyle + <char>_char). ai-toolkit — not kohya — because only it can
# qint4-quantize the Flux transformer + text encoder to fit ~16 GB VRAM.
APP_TRAIN_TOOL=ai-toolkit
APP_AITOOLKIT_DIR=/home/serg/ai-toolkit
# Interpreter to launch ai-toolkit with; empty uses <aitoolkit_dir>/venv/bin/python.
APP_TRAIN_PYTHON=
# Flux base (HF id or local path) — MUST match the style LoRA's base to stack.
APP_TRAIN_BASE_MODEL=black-forest-labs/FLUX.1-dev
# char-LoRA filename stem (and ai-toolkit run name); empty uses APP_TRIGGER_TOKEN.
APP_TRAIN_OUTPUT_NAME=
APP_TRAIN_NETWORK_DIM=32
APP_TRAIN_NETWORK_ALPHA=16
APP_TRAIN_STEPS=2200
APP_TRAIN_LEARNING_RATE=0.0001
APP_TRAIN_BATCH_SIZE=1
APP_TRAIN_RESOLUTION=512
# adafactor has near-zero optimizer state -> fits ~16 GB (adamw8bit needs more).
APP_TRAIN_OPTIMIZER=adafactor
APP_TRAIN_SAVE_EVERY=250
APP_TRAIN_GRADIENT_CHECKPOINTING=true
# Flux low-VRAM quantization (the part kohya can't do).
APP_TRAIN_QUANTIZE=true
# Use qfloat8 — NOT qint4: qint4's int4pack kernel is CUDA-only and clashes with
# low_vram's CPU quantization, throwing and producing no weights.
APP_TRAIN_QTYPE=qfloat8
APP_TRAIN_QTYPE_TE=qfloat8
APP_TRAIN_LOW_VRAM=true
APP_TRAIN_DISABLE_SAMPLING=true
# EMA weight smoothing — off to match the proven low-VRAM recipe; on if VRAM allows.
APP_TRAIN_USE_EMA=false
# Run training in run-all (off by default — heavy; run `make-char-dataset train`).
APP_RUN_TRAIN=false

# HF token for ai-toolkit to fetch the gated FLUX.1-dev base (read from HF_TOKEN).
# Not needed when APP_TRAIN_BASE_MODEL is a local path. SECRET — never commit.
HF_TOKEN=
